#: crates/clamui-core/src/audit.rs:293
msgid "ClamAV is not installed"
msgstr "ClamAV chưa được cài đặt"

#: crates/clamui-core/src/audit.rs:295
msgid "Install ClamAV to enable virus scanning"
msgstr "Cài đặt ClamAV để có thể quét virus"

#: crates/clamui-core/src/audit.rs:312
msgid "Installed: {version}"
msgstr "Đã cài đặt: {version}"

#: crates/clamui-core/src/audit.rs:323
msgid "Up to date ({days} day old, built {date})"
msgid_plural "Up to date ({days} days old, built {date})"
msgstr[0] "Đã cập nhật ({days} ngày tuổi, tạo ngày {date})"

#: crates/clamui-core/src/audit.rs:339 crates/clamui-core/src/audit.rs:357
msgid "Database is {days} day old (built {date})"
msgid_plural "Database is {days} days old (built {date})"
msgstr[0] "Cơ sở dữ liệu đã {days} ngày tuổi (tạo ngày {date})"

#: crates/clamui-core/src/audit.rs:347
msgid "Update virus database to ensure protection"
msgstr "Cập nhật cơ sở dữ liệu virus để đảm bảo được bảo vệ"

#: crates/clamui-core/src/audit.rs:365
msgid "Database is critically outdated. Update immediately."
msgstr "Cơ sở dữ liệu đã lỗi thời nghiêm trọng. Hãy cập nhật ngay."

#: crates/clamui-core/src/audit.rs:384
msgid "Database files exist but age could not be determined"
msgstr "Đã có tệp cơ sở dữ liệu nhưng không xác định được tuổi của chúng"

#: crates/clamui-core/src/audit.rs:386
msgid "No virus database found"
msgstr "Không tìm thấy cơ sở dữ liệu virus"

#: crates/clamui-core/src/audit.rs:390
msgid "Download virus database"
msgstr "Tải xuống cơ sở dữ liệu virus"

#: crates/clamui-core/src/audit.rs:406
msgid "Service {name} is running"
msgstr "Dịch vụ {name} đang chạy"

#: crates/clamui-core/src/audit.rs:417
msgid "Daemon is responding"
msgstr "Dịch vụ đang phản hồi"

#: crates/clamui-core/src/audit.rs:424
msgid "ClamAV daemon is not running"
msgstr "Dịch vụ ClamAV không chạy"

#: crates/clamui-core/src/audit.rs:426
msgid "Start the daemon for faster scanning"
msgstr "Khởi động dịch vụ để quét nhanh hơn"

#: crates/clamui-core/src/audit.rs:441
msgid "Freshclam service is active"
msgstr "Dịch vụ Freshclam đang hoạt động"

#: crates/clamui-core/src/audit.rs:448
msgid "Freshclam automatic update service is not running"
msgstr "Dịch vụ cập nhật tự động Freshclam không chạy"

#: crates/clamui-core/src/audit.rs:450
msgid "Enable automatic database updates"
msgstr "Bật cập nhật cơ sở dữ liệu tự động"

#: crates/clamui-core/src/audit.rs:645
msgid "{count} port listening, risky ports: {ports}"
msgid_plural "{count} ports listening, risky ports: {ports}"
msgstr[0] "{count} cổng đang lắng nghe, các cổng rủi ro: {ports}"

#: crates/clamui-core/src/audit.rs:656
msgid "Review if these services need to be exposed"
msgstr "Xem xét liệu các dịch vụ này có thật sự cần được mở ra ngoài hay không"

#: crates/clamui-core/src/audit.rs:663
msgid "{count} port listening"
msgid_plural "{count} ports listening"
msgstr[0] "{count} cổng đang lắng nghe"

#: crates/clamui-core/src/audit.rs:671
msgid "Review open ports and close unnecessary services"
msgstr "Xem lại các cổng đang mở và tắt các dịch vụ không cần thiết"

#: crates/clamui-core/src/audit.rs:678
msgid "No open ports detected"
msgstr "Không phát hiện cổng nào đang mở"

#: crates/clamui-core/src/audit.rs:709
msgid "AppArmor is enabled"
msgstr "AppArmor đã bật"

#: crates/clamui-core/src/audit.rs:716
msgid "AppArmor module is loaded but not enabled"
msgstr "Mô-đun AppArmor đã được nạp nhưng chưa bật"

#: crates/clamui-core/src/audit.rs:718
msgid "Enable AppArmor for application sandboxing"
msgstr "Bật AppArmor để chạy ứng dụng trong môi trường cô lập"

#: crates/clamui-core/src/audit.rs:733
msgid "SELinux is enforcing"
msgstr "SELinux đang ở chế độ thực thi (enforcing)"

#: crates/clamui-core/src/audit.rs:740
msgid "SELinux is in permissive mode"
msgstr "SELinux đang ở chế độ cho phép (permissive)"

#: crates/clamui-core/src/audit.rs:742
msgid "Consider switching to enforcing mode for stronger protection"
msgstr "Nên cân nhắc chuyển sang chế độ thực thi (enforcing) để bảo vệ tốt hơn"

#: crates/clamui-core/src/audit.rs:753
msgid "SELinux is disabled"
msgstr "SELinux đã tắt"

#: crates/clamui-core/src/audit.rs:755
msgid "Enable SELinux for mandatory access control"
msgstr "Bật SELinux để kiểm soát truy cập bắt buộc"

#: crates/clamui-core/src/audit.rs:769
msgid "No mandatory access control framework detected"
msgstr "Không phát hiện cơ chế kiểm soát truy cập bắt buộc nào"

#: crates/clamui-core/src/audit.rs:771
msgid "Consider enabling AppArmor or SELinux"
msgstr "Nên cân nhắc bật AppArmor hoặc SELinux"

#: crates/clamui-core/src/audit.rs:796
msgid "Automatic security updates are enabled"
msgstr "Cập nhật bảo mật tự động đã bật"

#: crates/clamui-core/src/audit.rs:806
msgid "Unattended upgrades is installed but disabled"
msgstr "Unattended upgrades đã được cài đặt nhưng đang tắt"

#: crates/clamui-core/src/audit.rs:808
msgid "Enable automatic security updates"
msgstr "Bật cập nhật bảo mật tự động"

#: crates/clamui-core/src/audit.rs:821
msgid "DNF automatic updates are enabled"
msgstr "Cập nhật tự động của DNF đã bật"

#: crates/clamui-core/src/audit.rs:831
msgid "DNF automatic is installed but timer is not active"
msgstr "DNF automatic đã được cài đặt nhưng bộ hẹn giờ chưa hoạt động"

#: crates/clamui-core/src/audit.rs:833
msgid "Enable automatic updates"
msgstr "Bật cập nhật tự động"

#: crates/clamui-core/src/audit.rs:846
msgid "Could not determine automatic update status"
msgstr "Không thể xác định trạng thái cập nhật tự động"

#: crates/clamui-core/src/audit.rs:848
msgid "Configure automatic security updates"
msgstr "Cấu hình cập nhật bảo mật tự động"

#: crates/clamui-core/src/audit.rs:862
msgid "System reboot required to apply updates"
msgstr "Cần khởi động lại hệ thống để áp dụng bản cập nhật"

#: crates/clamui-core/src/audit.rs:864
msgid "Reboot the system to apply pending security updates"
msgstr "Khởi động lại hệ thống để áp dụng các bản cập nhật bảo mật đang chờ"

#: crates/clamui-core/src/audit.rs:909
msgid "{name} is installed but not running"
msgstr "{name} đã được cài đặt nhưng không chạy"

#: crates/clamui-core/src/audit.rs:927
msgid "No intrusion detection system found"
msgstr "Không tìm thấy hệ thống phát hiện xâm nhập"

#: crates/clamui-core/src/audit.rs:929
msgid "Install fail2ban or CrowdSec to protect against attacks"
msgstr "Cài đặt fail2ban hoặc CrowdSec để bảo vệ trước các cuộc tấn công"

#: crates/clamui-core/src/audit.rs:955
msgid "SSH server is not running (no remote attack surface)"
msgstr "Máy chủ SSH không chạy (không có bề mặt tấn công từ xa)"

#: crates/clamui-core/src/audit.rs:965
msgid "SSH server is running"
msgstr "Máy chủ SSH đang chạy"

#: crates/clamui-core/src/audit.rs:974
msgid "Could not read SSH configuration"
msgstr "Không thể đọc cấu hình SSH"

#: crates/clamui-core/src/audit.rs:992
msgid "Root login: {value}"
msgstr "Đăng nhập root: {value}"

#: crates/clamui-core/src/audit.rs:999
msgid "Root login is allowed ({value})"
msgstr "Đăng nhập root đang được cho phép ({value})"

#: crates/clamui-core/src/audit.rs:1005
msgid "Disable root SSH login for security"
msgstr "Tắt đăng nhập SSH bằng root để bảo mật"

#: crates/clamui-core/src/audit.rs:1019
msgid "Password authentication is disabled (key-only)"
msgstr "Xác thực bằng mật khẩu đã tắt (chỉ dùng khóa)"

#: crates/clamui-core/src/audit.rs:1026
msgid "Password authentication is enabled"
msgstr "Xác thực bằng mật khẩu đã bật"

#: crates/clamui-core/src/audit.rs:1028
msgid "Consider disabling password auth in favor of SSH keys"
msgstr "Nên cân nhắc tắt xác thực bằng mật khẩu và chuyển sang dùng khóa SSH"

#: crates/clamui-core/src/audit.rs:1045
msgid "X11 forwarding is disabled"
msgstr "Chuyển tiếp X11 đã tắt"

#: crates/clamui-core/src/audit.rs:1052
msgid "X11 forwarding is enabled"
msgstr "Chuyển tiếp X11 đã bật"

#: crates/clamui-core/src/audit.rs:1054
msgid "Disable X11 forwarding to reduce attack surface"
msgstr "Tắt chuyển tiếp X11 để thu hẹp bề mặt tấn công"

#: crates/clamui-core/src/audit.rs:1129
msgid "Portmaster is running and protecting connections"
msgstr "Portmaster đang chạy và bảo vệ các kết nối"

#: crates/clamui-core/src/audit.rs:1153
msgid "Authorize ClamUI in Portmaster for per-module health"
msgstr ""
"Cấp quyền cho ClamUI trong Portmaster để xem tình trạng của từng mô-đun"

#: crates/clamui-core/src/audit.rs:1156
msgid "Authorize"
msgstr "Cấp quyền"

#: crates/clamui-core/src/audit.rs:1166
msgid "Portmaster is installed but not running"
msgstr "Portmaster đã được cài đặt nhưng không chạy"

#: crates/clamui-core/src/audit.rs:1168
msgid "Start the Portmaster service to enable network protection"
msgstr "Khởi động dịch vụ Portmaster để bật bảo vệ mạng"

#. Translators: The em dash separates the detection result from the component description.
#: crates/clamui-core/src/audit.rs:1181
msgid "Not detected — optional network monitor and application firewall"
msgstr "Không phát hiện — trình giám sát mạng và tường lửa ứng dụng tùy chọn"

#: crates/clamui-core/src/audit.rs:1195
msgid "Could not probe Portmaster: {error}"
msgstr "Không thể kiểm tra Portmaster: {error}"

#: crates/clamui-core/src/audit.rs:1245
msgid "{name} is not installed"
msgstr "{name} chưa được cài đặt"

#: crates/clamui-core/src/audit.rs:1251
msgid "Install {name} for comprehensive security auditing"
msgstr "Cài đặt {name} để kiểm tra bảo mật toàn diện"

#: crates/clamui-core/src/audit.rs:1257
msgid "Install chkrootkit for rootkit detection"
msgstr "Cài đặt chkrootkit để phát hiện rootkit"

#: crates/clamui-core/src/audit.rs:1276
msgid "Authentication was cancelled"
msgstr "Đã hủy xác thực"

#: crates/clamui-core/src/audit.rs:1284
msgid "Lynis audit timed out after 5 minutes"
msgstr "Kiểm tra bảo mật bằng Lynis đã hết thời gian chờ sau 5 phút"

#: crates/clamui-core/src/audit.rs:1286
msgid "Rootkit scan timed out after 5 minutes"
msgstr "Quét rootkit đã hết thời gian chờ sau 5 phút"

#: crates/clamui-core/src/audit.rs:1304 crates/clamui-core/src/audit.rs:1348
msgid "Failed to run Lynis: {error}"
msgstr "Không thể chạy Lynis: {error}"

#: crates/clamui-core/src/audit.rs:1310
msgid "Failed to run chkrootkit: {error}"
msgstr "Không thể chạy chkrootkit: {error}"

#: crates/clamui-core/src/audit.rs:1376
msgid "Score: {score}/100"
msgstr "Điểm: {score}/100"

#. Translators: Keep the quoted shell command unchanged.
#: crates/clamui-core/src/audit.rs:1379
msgid "Run 'sudo lynis audit system' for detailed recommendations"
msgstr "Chạy “sudo lynis audit system” để xem các khuyến nghị chi tiết"

#: crates/clamui-core/src/audit.rs:1395
msgid "Audit completed (exit code {code})"
msgstr "Đã hoàn tất kiểm tra bảo mật (mã thoát {code})"

#: crates/clamui-core/src/audit.rs:1433 crates/clamui-core/src/audit.rs:1447
msgid "Rootkit scan could not be completed (exit {code})"
msgstr "Không thể hoàn tất quét rootkit (mã thoát {code})"

#: crates/clamui-core/src/audit.rs:1477
msgid "No rootkits detected"
msgstr "Không phát hiện rootkit nào"

#: crates/clamui-core/src/audit.rs:1488
msgid "{count} potential rootkit detected"
msgid_plural "{count} potential rootkits detected"
msgstr[0] "Phát hiện {count} rootkit tiềm ẩn"

#: crates/clamui-core/src/audit.rs:1496
msgid "Investigate the detected threats immediately"
msgstr "Hãy điều tra ngay các mối đe dọa đã phát hiện"

#: crates/clamui-core/src/audit/firewall.rs:53
msgid "Firewall manager overlap"
msgstr "Các trình quản lý tường lửa chồng chéo"

#: crates/clamui-core/src/audit/firewall.rs:54
msgid ""
"UFW is active while Firewalld owns its D-Bus name; their rule interaction "
"was not evaluated."
msgstr ""
"UFW đang hoạt động trong khi Firewalld đang giữ tên D-Bus của nó; tương tác "
"giữa các quy tắc của hai bên chưa được đánh giá."

#: crates/clamui-core/src/audit/firewall.rs:157
msgid "UFW Firewall"
msgstr "Tường lửa UFW"

#: crates/clamui-core/src/audit/firewall.rs:162
msgid ""
"UFW is active; the default incoming policy is deny. Listed rules may allow "
"exceptions."
msgstr ""
"UFW đang hoạt động; chính sách mặc định cho kết nối đến là chặn (deny). Các "
"quy tắc được liệt kê có thể cho phép ngoại lệ."

#: crates/clamui-core/src/audit/firewall.rs:169
msgid ""
"UFW is active; the default incoming policy is reject. Listed rules may allow "
"exceptions."
msgstr ""
"UFW đang hoạt động; chính sách mặc định cho kết nối đến là từ chối (reject). "
"Các quy tắc được liệt kê có thể cho phép ngoại lệ."

#: crates/clamui-core/src/audit/firewall.rs:176
msgid "UFW is active; the default incoming policy is deny."
msgstr ""
"UFW đang hoạt động; chính sách mặc định cho kết nối đến là chặn (deny)."

#: crates/clamui-core/src/audit/firewall.rs:180
msgid "UFW is active; the default incoming policy is reject."
msgstr ""
"UFW đang hoạt động; chính sách mặc định cho kết nối đến là từ chối (reject)."

#: crates/clamui-core/src/audit/firewall.rs:184
msgid "UFW is active, but the default incoming policy allows traffic."
msgstr ""
"UFW đang hoạt động nhưng chính sách mặc định cho kết nối đến lại cho phép "
"lưu lượng đi qua."

#: crates/clamui-core/src/audit/firewall.rs:191
msgid "UFW is active, but its default incoming policy could not be verified."
msgstr ""
"UFW đang hoạt động nhưng không thể xác minh chính sách mặc định cho kết nối "
"đến."

#: crates/clamui-core/src/audit/firewall.rs:195
msgid "UFW reports inactive."
msgstr "UFW cho biết đang không hoạt động."

#: crates/clamui-core/src/audit/firewall.rs:196
msgid "UFW status could not be inspected safely."
msgstr "Không thể kiểm tra trạng thái UFW một cách an toàn."

#: crates/clamui-core/src/audit/firewall.rs:234
msgid "Firewalld"
msgstr "Firewalld"

#: crates/clamui-core/src/audit/firewall.rs:236
msgid ""
"Firewalld owns its D-Bus name; readiness and firewall policy were not "
"queried."
msgstr ""
"Firewalld đang giữ tên D-Bus của nó; chưa truy vấn trạng thái sẵn sàng và "
"chính sách tường lửa."

#: crates/clamui-core/src/audit/firewall.rs:240
msgid ""
"No Firewalld D-Bus owner was observed; this does not establish kernel "
"firewall policy."
msgstr ""
"Không thấy tiến trình nào giữ tên D-Bus của Firewalld; điều này không đủ để "
"xác định chính sách tường lửa của nhân hệ điều hành."

#: crates/clamui-core/src/audit/firewall.rs:244
msgid ""
"Firewalld ownership could not be verified; readiness and firewall policy "
"were not queried."
msgstr ""
"Không thể xác minh Firewalld có đang giữ tên D-Bus hay không; chưa truy vấn "
"trạng thái sẵn sàng và chính sách tường lửa."

#: crates/clamui-core/src/audit/firewall.rs:259
msgid "firewall-cmd"
msgstr "firewall-cmd"

#: crates/clamui-core/src/audit/firewall.rs:264
msgid "firewall-cmd is installed; it was not executed."
msgstr "firewall-cmd đã được cài đặt; công cụ này chưa được chạy."

#: crates/clamui-core/src/audit/firewall.rs:270
msgid "firewall-cmd could not be confirmed without executing it."
msgstr "Không thể xác nhận firewall-cmd nếu không chạy nó."

#: crates/clamui-core/src/audit/firewall.rs:408
msgid "nftables (native rules)"
msgstr "nftables (quy tắc gốc)"

#: crates/clamui-core/src/audit/firewall.rs:410
msgid ""
"nftables has restrictive default input policies for IPv4 and IPv6; "
"individual rules may allow exceptions."
msgstr ""
"nftables có chính sách mặc định hạn chế cho lưu lượng vào trên IPv4 và IPv6; "
"từng quy tắc riêng lẻ có thể cho phép ngoại lệ."

#: crates/clamui-core/src/audit/firewall.rs:414
msgid ""
"nftables reports a permissive default input policy; remaining coverage may "
"be incomplete"
msgstr ""
"nftables báo cáo chính sách mặc định cho lưu lượng vào là cho phép; phạm vi "
"kiểm tra còn lại có thể chưa đầy đủ"

#: crates/clamui-core/src/audit/firewall.rs:418
msgid ""
"nftables input policy coverage could not be verified for both IPv4 and IPv6"
msgstr ""
