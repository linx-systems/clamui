{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Local ClamUI frontend only; all privileged file and process access stays behind audited Rust commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:app:default",
    "clipboard-manager:allow-write-text",
    "notification:allow-is-permission-granted",
    "allow-request",
    "allow-choose-paths",
    "allow-save-export",
    "allow-copy-text",
    "allow-open-external",
    "allow-open-path",
    "allow-app-close",
    "allow-startup-state"
  ]
}
