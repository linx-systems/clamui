---
import InstallTabGroup, { type Tab } from "./InstallTabGroup.astro";

/* Step 1: ClamAV from the distribution. Package and service names were
   checked against each distribution's packaging (Debian, Fedora rawhide
   spec, Arch PKGBUILD, openSUSE pool) and match ClamUI's own hints in
   crates/clamui-core/src/host.rs. */
const clamav: Tab[] = [
  {
    id: "debian",
    label: "Debian / Ubuntu",
    blocks: [
      {
        title: "Scanner and virus definitions",
        badge: "Required",
        note: "The freshclam service downloads the definitions in the background and keeps them current. The first download takes a few minutes.",
        code: "sudo apt install clamav clamav-freshclam\nsudo systemctl enable --now clamav-freshclam",
      },
      {
        title: "Scan daemon",
        badge: "Optional",
        note: "Keeps the engine loaded, so repeat scans start in seconds. Start it once the definitions have finished downloading.",
        code: "sudo apt install clamav-daemon\nsudo systemctl enable --now clamav-daemon",
      },
    ],
  },
  {
    id: "fedora",
    label: "Fedora",
    blocks: [
      {
        title: "Scanner and virus definitions",
        badge: "Required",
        code: "sudo dnf install clamav clamav-freshclam\nsudo freshclam\nsudo systemctl enable --now clamav-freshclam",
      },
      {
        title: "Scan daemon",
        badge: "Optional",
        note: "Fedora ships the daemon's socket switched off; the second line turns it on.",
        code: "sudo dnf install clamd\nsudo sed -i 's/^#LocalSocket /LocalSocket /' /etc/clamd.d/scan.conf\nsudo systemctl enable --now clamd@scan",
      },
    ],
    footnote: "Silverblue or Kinoite: use rpm-ostree install with the same package names, then reboot.",
  },
  {
    id: "arch",
    label: "Arch Linux",
    blocks: [
      {
        title: "Scanner and virus definitions",
        badge: "Required",
        code: "sudo pacman -S clamav\nsudo freshclam\nsudo systemctl enable --now clamav-freshclam",
      },
      {
        title: "Scan daemon",
        badge: "Optional",
        note: "Already part of the clamav package.",
        code: "sudo systemctl enable --now clamav-daemon",
      },
    ],
  },
  {
    id: "opensuse",
    label: "openSUSE",
    blocks: [
      {
        title: "Scanner and virus definitions",
        badge: "Required",
        code: "sudo zypper install clamav\nsudo freshclam\nsudo systemctl enable --now freshclam.timer",
      },
      {
        title: "Scan daemon",
        badge: "Optional",
        note: "Already part of the clamav package.",
        code: "sudo systemctl enable --now clamd",
      },
    ],
  },
];

/* Step 2: ClamUI itself. */
const clamui: Tab[] = [
  {
    id: "flathub",
    label: "Flathub",
    sub: "Recommended",
    intro: "Works on any distribution, on x86_64 and aarch64, and updates with the rest of your apps. You can also search for ClamUI in GNOME Software or KDE Discover.",
    blocks: [
      {
        code: "flatpak install flathub io.github.linx_systems.ClamUI",
      },
    ],
    footnote: "Flathub not set up yet? Run flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo first.",
  },
  {
    id: "deb",
    label: "Debian / Ubuntu",
    sub: ".deb",
    intro: "Download both v0.6.0 packages for your architecture from GitHub Releases, then install them together. The helper lets ClamUI change ClamAV settings with your administrator password.",
    blocks: [
      {
        code: "DEB_ARCH=\"$(dpkg --print-architecture)\"\nsudo apt install \"./clamui_0.6.0_${DEB_ARCH}.deb\" \\\n  \"./clamui-privileged-helper_0.6.0_${DEB_ARCH}.deb\"",
      },
    ],
  },
  {
    id: "appimage",
    label: "AppImage",
    sub: "x86_64",
    intro: "A single file that runs without installing. Download it from GitHub Releases.",
    blocks: [
      {
        code: "chmod +x ClamUI-0.6.0-x86_64.AppImage\n./ClamUI-0.6.0-x86_64.AppImage",
      },
    ],
  },
  {
    id: "bundle",
    label: "Flatpak bundle",
    sub: "Offline",
    intro: "The same app as Flathub as a single file, for machines without Flathub access. Pick clamui-x86_64.flatpak or clamui-aarch64.flatpak. It does not update on its own.",
    blocks: [
      {
        code: "flatpak install --user ./clamui-x86_64.flatpak",
      },
    ],
  },
  {
    id: "source",
    label: "From source",
    sub: "Developers",
    intro: "Needs Rust, Bun, WebKitGTK 4.1 and GTK 3 development packages.",
    blocks: [
      {
        code: "git clone https://github.com/linx-systems/clamui.git\ncd clamui\n( cd desktop && bun install --frozen-lockfile )\nbun run --cwd desktop tauri dev",
      },
    ],
  },
];

const releaseUrl = "https://github.com/linx-systems/clamui/releases/tag/v0.6.0";
---

<section id="install" class="container-tight py-20 sm:py-28">
  <div class="max-w-2xl">
    <span class="eyebrow">Get it running</span>
    <h2 class="mt-3 section-title">Install</h2>
    <p class="mt-4 lede">
      Two steps. ClamUI is the interface; the virus scanner itself is ClamAV from your
      distribution, so it gets security updates like the rest of your system.
    </p>
  </div>

  <ol class="mt-10 space-y-12">
    <li>
      <div class="flex items-start gap-4 mb-5">
        <span class="grid place-items-center w-8 h-8 rounded-full bg-clam-forest/15 border border-clam-forest/25 text-clam-sage font-mono text-sm shrink-0" aria-hidden="true">1</span>
        <div>
          <h3 class="text-lg font-semibold text-white">Install ClamAV</h3>
          <p class="text-sm text-white/60 mt-1">
            Pick your distribution. The daemon is optional; ClamUI uses it automatically when it is running.
          </p>
        </div>
      </div>
      <InstallTabGroup group="clamav" label="Your distribution" tabs={clamav} />
    </li>

    <li>
      <div class="flex items-start gap-4 mb-5">
        <span class="grid place-items-center w-8 h-8 rounded-full bg-clam-forest/15 border border-clam-forest/25 text-clam-sage font-mono text-sm shrink-0" aria-hidden="true">2</span>
        <div>
          <h3 class="text-lg font-semibold text-white">Install ClamUI</h3>
          <p class="text-sm text-white/60 mt-1">
            Flathub is the easiest choice on every distribution. Downloads for the other formats are on
            <a href={releaseUrl} rel="noopener" class="text-clam-sage hover:text-white transition-colors">GitHub Releases (v0.6.0)</a>.
          </p>
        </div>
      </div>
      <InstallTabGroup group="clamui" label="Install method" tabs={clamui} />
    </li>

    <li class="flex items-start gap-4">
      <span class="grid place-items-center w-8 h-8 rounded-full bg-clam-forest/15 border border-clam-forest/25 text-clam-sage font-mono text-sm shrink-0" aria-hidden="true">3</span>
      <div>
        <h3 class="text-lg font-semibold text-white">Open ClamUI</h3>
        <p class="text-sm text-white/60 mt-1 max-w-2xl">
          Start it from your app menu. The <span class="text-white/80">Components</span> page shows
          whether ClamAV, the virus definitions and the daemon were found, with the exact command
          for anything that is missing.
        </p>
      </div>
    </li>
  </ol>

  <div class="mt-10 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-white/50">
    <a href="/docs/installation/" class="text-clam-sage hover:text-white transition-colors">
      Full installation guide
    </a>
    <a href="/docs/reference/scan-backends/" class="hover:text-white transition-colors">
      Daemon setup in detail
    </a>
    <a href="/docs/contributing/signing/" class="hover:text-white transition-colors">
      Verify downloads
    </a>
  </div>
</section>
