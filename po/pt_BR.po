#: crates/clamui-core/src/audit.rs:293
msgid "ClamAV is not installed"
msgstr "ClamAV não está instalado"

#: crates/clamui-core/src/audit.rs:295
msgid "Install ClamAV to enable virus scanning"
msgstr "Instale o ClamAV para ativar a verificação de vírus"

#: crates/clamui-core/src/audit.rs:312
msgid "Installed: {version}"
msgstr "Instalado: {version}"

#: crates/clamui-core/src/audit.rs:323
msgid "Up to date ({days} day old, built {date})"
msgid_plural "Up to date ({days} days old, built {date})"
msgstr[0] "Atualizado ({days} dia de idade, compilado em {date})"
msgstr[1] "Atualizado ({days} dias de idade, compilado em {date})"

#: crates/clamui-core/src/audit.rs:339 crates/clamui-core/src/audit.rs:357
msgid "Database is {days} day old (built {date})"
msgid_plural "Database is {days} days old (built {date})"
msgstr[0] "O banco de dados tem {days} dia de idade (compilado em {date})"
msgstr[1] "O banco de dados tem {days} dias de idade (compilado em {date})"

#: crates/clamui-core/src/audit.rs:347
msgid "Update virus database to ensure protection"
msgstr "Atualize o banco de dados de vírus para garantir proteção"

#: crates/clamui-core/src/audit.rs:365
msgid "Database is critically outdated. Update immediately."
msgstr ""
"O banco de dados está criticamente desatualizado. Atualize-o imediatamente."

#: crates/clamui-core/src/audit.rs:384
msgid "Database files exist but age could not be determined"
msgstr ""
"Existem arquivos de banco de dados, mas a idade não pôde ser determinada"

#: crates/clamui-core/src/audit.rs:386
msgid "No virus database found"
msgstr "Nenhum banco de dados de vírus encontrado"

#: crates/clamui-core/src/audit.rs:390
msgid "Download virus database"
msgstr "Baixar banco de dados de vírus"

#: crates/clamui-core/src/audit.rs:406
msgid "Service {name} is running"
msgstr "O serviço {name} está em execução"

#: crates/clamui-core/src/audit.rs:417
msgid "Daemon is responding"
msgstr "Daemon está respondendo"

#: crates/clamui-core/src/audit.rs:424
msgid "ClamAV daemon is not running"
msgstr "O daemon ClamAV não está em execução"

#: crates/clamui-core/src/audit.rs:426
msgid "Start the daemon for faster scanning"
msgstr "Inicie o daemon para uma verificação mais rápida"

#: crates/clamui-core/src/audit.rs:441
msgid "Freshclam service is active"
msgstr "O serviço Freshclam está ativo"

#: crates/clamui-core/src/audit.rs:448
msgid "Freshclam automatic update service is not running"
msgstr "O serviço de atualização automática Freshclam não está em execução"

#: crates/clamui-core/src/audit.rs:450
msgid "Enable automatic database updates"
msgstr "Habilite atualizações automáticas do banco de dados"

#: crates/clamui-core/src/audit.rs:645
msgid "{count} port listening, risky ports: {ports}"
msgid_plural "{count} ports listening, risky ports: {ports}"
msgstr[0] "{count} porta em escuta, portas de risco: {ports}"
msgstr[1] "{count} portas em escuta, portas de risco: {ports}"

#: crates/clamui-core/src/audit.rs:656
msgid "Review if these services need to be exposed"
msgstr "Revise se esses serviços precisam ser expostos"

#: crates/clamui-core/src/audit.rs:663
msgid "{count} port listening"
msgid_plural "{count} ports listening"
msgstr[0] "{count} porta em escuta"
msgstr[1] "{count} portas em escuta"

#: crates/clamui-core/src/audit.rs:671
msgid "Review open ports and close unnecessary services"
msgstr "Revise as portas abertas e feche serviços desnecessários"

#: crates/clamui-core/src/audit.rs:678
msgid "No open ports detected"
msgstr "Nenhuma porta aberta detectada"

#: crates/clamui-core/src/audit.rs:709
msgid "AppArmor is enabled"
msgstr "AppArmor está ativado"

#: crates/clamui-core/src/audit.rs:716
msgid "AppArmor module is loaded but not enabled"
msgstr "O módulo AppArmor está carregado, mas não ativado"

#: crates/clamui-core/src/audit.rs:718
msgid "Enable AppArmor for application sandboxing"
msgstr "Habilite o AppArmor para sandbox de aplicativos"

#: crates/clamui-core/src/audit.rs:733
msgid "SELinux is enforcing"
msgstr "SELinux está aplicando"

#: crates/clamui-core/src/audit.rs:740
msgid "SELinux is in permissive mode"
msgstr "SELinux está em modo permissivo"

#: crates/clamui-core/src/audit.rs:742
msgid "Consider switching to enforcing mode for stronger protection"
msgstr "Considere mudar para o modo de imposição para uma proteção mais forte"

#: crates/clamui-core/src/audit.rs:753
msgid "SELinux is disabled"
msgstr "SELinux está desabilitado"

#: crates/clamui-core/src/audit.rs:755
msgid "Enable SELinux for mandatory access control"
msgstr "Habilite o SELinux para controle de acesso obrigatório"

#: crates/clamui-core/src/audit.rs:769
msgid "No mandatory access control framework detected"
msgstr "Nenhuma estrutura de controle de acesso obrigatória detectada"

#: crates/clamui-core/src/audit.rs:771
msgid "Consider enabling AppArmor or SELinux"
msgstr "Considere ativar o AppArmor ou SELinux"

#: crates/clamui-core/src/audit.rs:796
msgid "Automatic security updates are enabled"
msgstr "As atualizações automáticas de segurança estão habilitadas"

#: crates/clamui-core/src/audit.rs:806
msgid "Unattended upgrades is installed but disabled"
msgstr "As atualizações autônomas estão instaladas, mas desabilitadas"

#: crates/clamui-core/src/audit.rs:808
msgid "Enable automatic security updates"
msgstr "Habilite atualizações automáticas de segurança"

#: crates/clamui-core/src/audit.rs:821
msgid "DNF automatic updates are enabled"
msgstr "As atualizações automáticas DNF estão ativadas"

#: crates/clamui-core/src/audit.rs:831
msgid "DNF automatic is installed but timer is not active"
msgstr "O DNF automático está instalado, mas o temporizador não está ativo"

#: crates/clamui-core/src/audit.rs:833
msgid "Enable automatic updates"
msgstr "Habilite atualizações automáticas"

#: crates/clamui-core/src/audit.rs:846
msgid "Could not determine automatic update status"
msgstr "Não foi possível determinar o status da atualização automática"

#: crates/clamui-core/src/audit.rs:848
msgid "Configure automatic security updates"
msgstr "Configurar atualizações automáticas de segurança"

#: crates/clamui-core/src/audit.rs:862
msgid "System reboot required to apply updates"
msgstr "Reinicialização do sistema necessária para aplicar atualizações"

#: crates/clamui-core/src/audit.rs:864
msgid "Reboot the system to apply pending security updates"
msgstr "Reinicie o sistema para aplicar as atualizações de segurança pendentes"

#: crates/clamui-core/src/audit.rs:909
msgid "{name} is installed but not running"
msgstr "{name} está instalado, mas não está em execução"

#: crates/clamui-core/src/audit.rs:927
msgid "No intrusion detection system found"
msgstr "Nenhum sistema de detecção de intrusão encontrado"

#: crates/clamui-core/src/audit.rs:929
msgid "Install fail2ban or CrowdSec to protect against attacks"
msgstr "Instale o fail2ban ou o CrowdSec para proteger contra ataques"

#: crates/clamui-core/src/audit.rs:955
msgid "SSH server is not running (no remote attack surface)"
msgstr "O servidor SSH não está em execução (sem superfície de ataque remoto)"

#: crates/clamui-core/src/audit.rs:965
msgid "SSH server is running"
msgstr "O servidor SSH está em execução"

#: crates/clamui-core/src/audit.rs:974
msgid "Could not read SSH configuration"
msgstr "Não foi possível ler a configuração SSH"

#: crates/clamui-core/src/audit.rs:992
msgid "Root login: {value}"
msgstr "Login raiz: {value}"

#: crates/clamui-core/src/audit.rs:999
msgid "Root login is allowed ({value})"
msgstr "O login de root é permitido ({value})"

#: crates/clamui-core/src/audit.rs:1005
msgid "Disable root SSH login for security"
msgstr "Desative o login SSH root para segurança"

#: crates/clamui-core/src/audit.rs:1019
msgid "Password authentication is disabled (key-only)"
msgstr "A autenticação por senha está desativada (somente chave)"

#: crates/clamui-core/src/audit.rs:1026
msgid "Password authentication is enabled"
msgstr "A autenticação por senha está habilitada"

#: crates/clamui-core/src/audit.rs:1028
msgid "Consider disabling password auth in favor of SSH keys"
msgstr "Considere desativar a autenticação por senha em favor de chaves SSH"

#: crates/clamui-core/src/audit.rs:1045
msgid "X11 forwarding is disabled"
msgstr "O encaminhamento X11 está desabilitado"

#: crates/clamui-core/src/audit.rs:1052
msgid "X11 forwarding is enabled"
msgstr "O encaminhamento X11 está ativado"

#: crates/clamui-core/src/audit.rs:1054
msgid "Disable X11 forwarding to reduce attack surface"
msgstr "Desative o encaminhamento X11 para reduzir a superfície de ataque"

#: crates/clamui-core/src/audit.rs:1129
msgid "Portmaster is running and protecting connections"
msgstr "Portmaster está executando e protegendo conexões"

#: crates/clamui-core/src/audit.rs:1153
msgid "Authorize ClamUI in Portmaster for per-module health"
msgstr "Autorize ClamUI no Portmaster para integridade por módulo"

#: crates/clamui-core/src/audit.rs:1156
msgid "Authorize"
msgstr "Autorizar"

#: crates/clamui-core/src/audit.rs:1166
msgid "Portmaster is installed but not running"
msgstr "Portmaster está instalado, mas não está funcionando"

#: crates/clamui-core/src/audit.rs:1168
msgid "Start the Portmaster service to enable network protection"
msgstr "Inicie o serviço Portmaster para habilitar a proteção de rede"

#. Translators: The em dash separates the detection result from the component description.
#: crates/clamui-core/src/audit.rs:1181
msgid "Not detected — optional network monitor and application firewall"
msgstr "Não detectado — monitor de rede e firewall de aplicativos opcionais"

#: crates/clamui-core/src/audit.rs:1195
msgid "Could not probe Portmaster: {error}"
msgstr "Não foi possível verificar o Portmaster: {error}"

#: crates/clamui-core/src/audit.rs:1245
msgid "{name} is not installed"
msgstr "{name} não está instalado"

#: crates/clamui-core/src/audit.rs:1251
msgid "Install {name} for comprehensive security auditing"
msgstr "Instale {name} para uma auditoria de segurança abrangente"

#: crates/clamui-core/src/audit.rs:1257
msgid "Install chkrootkit for rootkit detection"
msgstr "Instale o chkrootkit para detecção de rootkit"

#: crates/clamui-core/src/audit.rs:1276
msgid "Authentication was cancelled"
msgstr "A autenticação foi cancelada"

#: crates/clamui-core/src/audit.rs:1284
msgid "Lynis audit timed out after 5 minutes"
msgstr "A auditoria do Lynis excedeu o tempo limite de 5 minutos"

#: crates/clamui-core/src/audit.rs:1286
msgid "Rootkit scan timed out after 5 minutes"
msgstr "A verificação de rootkits excedeu o tempo limite de 5 minutos"

#: crates/clamui-core/src/audit.rs:1304 crates/clamui-core/src/audit.rs:1348
msgid "Failed to run Lynis: {error}"
msgstr "Falha ao executar o Lynis: {error}"

#: crates/clamui-core/src/audit.rs:1310
msgid "Failed to run chkrootkit: {error}"
msgstr "Falha ao executar o chkrootkit: {error}"

#: crates/clamui-core/src/audit.rs:1376
msgid "Score: {score}/100"
msgstr "Pontuação: {score}/100"

#. Translators: Keep the quoted shell command unchanged.
#: crates/clamui-core/src/audit.rs:1379
msgid "Run 'sudo lynis audit system' for detailed recommendations"
msgstr "Execute 'sudo lynis audit system' para obter recomendações detalhadas"

#: crates/clamui-core/src/audit.rs:1395
msgid "Audit completed (exit code {code})"
msgstr "Auditoria concluída (código de saída {code})"

#: crates/clamui-core/src/audit.rs:1433 crates/clamui-core/src/audit.rs:1447
msgid "Rootkit scan could not be completed (exit {code})"
msgstr "Não foi possível concluir a verificação de rootkits (saída {code})"

#: crates/clamui-core/src/audit.rs:1477
msgid "No rootkits detected"
msgstr "Nenhum rootkit detectado"

#: crates/clamui-core/src/audit.rs:1488
msgid "{count} potential rootkit detected"
msgid_plural "{count} potential rootkits detected"
msgstr[0] "{count} possível rootkit detectado"
msgstr[1] "{count} possíveis rootkits detectados"

#: crates/clamui-core/src/audit.rs:1496
msgid "Investigate the detected threats immediately"
msgstr "Investigue as ameaças detectadas imediatamente"

#: crates/clamui-core/src/audit/firewall.rs:53
msgid "Firewall manager overlap"
msgstr "Conflito entre gerenciadores de firewall"

#: crates/clamui-core/src/audit/firewall.rs:54
msgid ""
"UFW is active while Firewalld owns its D-Bus name; their rule interaction "
"was not evaluated."
msgstr ""
"O UFW está ativo enquanto o Firewalld possui seu nome no D-Bus; a interação "
"entre suas regras não foi avaliada."

#: crates/clamui-core/src/audit/firewall.rs:157
msgid "UFW Firewall"
msgstr "Firewall UFW"

#: crates/clamui-core/src/audit/firewall.rs:162
msgid ""
"UFW is active; the default incoming policy is deny. Listed rules may allow "
"exceptions."
msgstr ""
"O UFW está ativo; a política padrão de entrada é negar. As regras listadas "
"podem permitir exceções."

#: crates/clamui-core/src/audit/firewall.rs:169
msgid ""
"UFW is active; the default incoming policy is reject. Listed rules may allow "
"exceptions."
msgstr ""
"O UFW está ativo; a política padrão de entrada é rejeitar. As regras "
"listadas podem permitir exceções."

#: crates/clamui-core/src/audit/firewall.rs:176
msgid "UFW is active; the default incoming policy is deny."
msgstr "O UFW está ativo; a política padrão de entrada é negar."

#: crates/clamui-core/src/audit/firewall.rs:180
msgid "UFW is active; the default incoming policy is reject."
msgstr "O UFW está ativo; a política padrão de entrada é rejeitar."

#: crates/clamui-core/src/audit/firewall.rs:184
msgid "UFW is active, but the default incoming policy allows traffic."
msgstr "O UFW está ativo, mas sua política padrão de entrada permite tráfego."

#: crates/clamui-core/src/audit/firewall.rs:191
msgid "UFW is active, but its default incoming policy could not be verified."
msgstr ""
"O UFW está ativo, mas não foi possível verificar sua política padrão de "
"entrada."

#: crates/clamui-core/src/audit/firewall.rs:195
msgid "UFW reports inactive."
msgstr "O UFW informa estar inativo."

#: crates/clamui-core/src/audit/firewall.rs:196
msgid "UFW status could not be inspected safely."
msgstr "Não foi possível inspecionar com segurança o status do UFW."

#: crates/clamui-core/src/audit/firewall.rs:234
msgid "Firewalld"
msgstr "Firewalld"

#: crates/clamui-core/src/audit/firewall.rs:236
msgid ""
"Firewalld owns its D-Bus name; readiness and firewall policy were not "
"queried."
msgstr ""
"O Firewalld possui seu nome no D-Bus; sua prontidão e política de firewall "
"não foram consultadas."

#: crates/clamui-core/src/audit/firewall.rs:240
msgid ""
"No Firewalld D-Bus owner was observed; this does not establish kernel "
"firewall policy."
msgstr ""
"Nenhum proprietário do Firewalld no D-Bus foi observado; isso não determina "
"a política de firewall do kernel."

#: crates/clamui-core/src/audit/firewall.rs:244
msgid ""
"Firewalld ownership could not be verified; readiness and firewall policy "
"were not queried."
msgstr ""
"Não foi possível verificar a propriedade do Firewalld; sua prontidão e "
"política de firewall não foram consultadas."

#: crates/clamui-core/src/audit/firewall.rs:259
msgid "firewall-cmd"
msgstr "firewall-cmd"

#: crates/clamui-core/src/audit/firewall.rs:264
msgid "firewall-cmd is installed; it was not executed."
msgstr "O firewall-cmd está instalado; ele não foi executado."

#: crates/clamui-core/src/audit/firewall.rs:270
msgid "firewall-cmd could not be confirmed without executing it."
msgstr "Não foi possível confirmar o firewall-cmd sem executá-lo."

#: crates/clamui-core/src/audit/firewall.rs:408
msgid "nftables (native rules)"
msgstr "nftables (regras nativas)"

#: crates/clamui-core/src/audit/firewall.rs:410
msgid ""
"nftables has restrictive default input policies for IPv4 and IPv6; "
"individual rules may allow exceptions."
msgstr ""
"O nftables possui políticas padrão de entrada restritivas para IPv4 e IPv6; "
"regras individuais podem permitir exceções."

#: crates/clamui-core/src/audit/firewall.rs:414
msgid ""
"nftables reports a permissive default input policy; remaining coverage may "
"be incomplete"
msgstr ""
"O nftables informa uma política padrão de entrada permissiva; a cobertura "
"restante pode estar incompleta"

#: crates/clamui-core/src/audit/firewall.rs:418
msgid ""
"nftables input policy coverage could not be verified for both IPv4 and IPv6"
msgstr ""
"Não foi possível verificar a cobertura da política de entrada do nftables "
"para IPv4 e IPv6"

#: crates/clamui-core/src/audit/firewall.rs:478
msgid "iptables (IPv4)"
msgstr "iptables (IPv4)"

#: crates/clamui-core/src/audit/firewall.rs:480
msgid ""
"iptables has a restrictive INPUT default policy; individual rules may allow "
"exceptions."
msgstr ""
"O iptables possui uma política padrão INPUT restritiva; regras individuais "
"podem permitir exceções."

#: crates/clamui-core/src/audit/firewall.rs:484
msgid "iptables has a permissive INPUT default policy"
msgstr "O iptables possui uma política padrão INPUT permissiva"

#: crates/clamui-core/src/audit/firewall.rs:485
msgid "iptables INPUT policy could not be verified"
msgstr "Não foi possível verificar a política INPUT do iptables"

#: crates/clamui-core/src/audit/firewall.rs:491
msgid "iptables (IPv6)"
msgstr "iptables (IPv6)"

#: crates/clamui-core/src/audit/firewall.rs:493
msgid ""
"ip6tables has a restrictive INPUT default policy; individual rules may allow "
"exceptions."
msgstr ""
"O ip6tables possui uma política padrão INPUT restritiva; regras individuais "
"podem permitir exceções."

#: crates/clamui-core/src/audit/firewall.rs:497
msgid "ip6tables has a permissive INPUT default policy"
msgstr "O ip6tables possui uma política padrão INPUT permissiva"

#: crates/clamui-core/src/audit/firewall.rs:498
msgid "ip6tables INPUT policy could not be verified"
msgstr "Não foi possível verificar a política INPUT do ip6tables"

#: crates/clamui-core/src/audit/firewall.rs:508
msgid "Gufw"
msgstr "Gufw"

#: crates/clamui-core/src/audit/firewall.rs:510
msgid "Gufw is available."
msgstr "O Gufw está disponível."

#: crates/clamui-core/src/audit/firewall.rs:512
msgid ""
"Gufw was not confirmed; this optional inventory does not affect firewall "
"policy analysis."
msgstr ""
"O Gufw não foi confirmado; este inventário opcional não afeta a análise da "
"política de firewall."

#: crates/clamui-core/src/audit/firewall.rs:519
msgid "Open Gufw"
msgstr "Abrir Gufw"

#: crates/clamui-core/src/audit/firewall.rs:525
msgid "Firewall Config"
msgstr "Configuração do firewall"

#: crates/clamui-core/src/audit/firewall.rs:530
msgid "Firewall Config is available."
msgstr "A Configuração do firewall está disponível."

#: crates/clamui-core/src/audit/firewall.rs:533
msgid ""
"Firewall Config was not confirmed; this optional inventory does not affect "
"firewall policy analysis."
msgstr ""
"A Configuração do firewall não foi confirmada; este inventário opcional não "
"afeta a análise da política de firewall."

#: crates/clamui-core/src/audit/firewall.rs:540
msgid "Open Firewall Config"
msgstr "Abrir Configuração do firewall"

#: crates/clamui-core/src/audit/firewall.rs:578
msgid "Plasma Firewall"
msgstr "Firewall do Plasma"

#: crates/clamui-core/src/audit/firewall.rs:583
msgid "Plasma Firewall is installed; it manages an existing firewall backend."
msgstr ""
"O Firewall do Plasma está instalado; ele gerencia uma infraestrutura de "
"firewall existente."

#: crates/clamui-core/src/audit/firewall.rs:592
msgid "Plasma Firewall was not confirmed; it is only a management module."
msgstr ""
"O Firewall do Plasma não foi confirmado; ele é apenas um módulo de "
"gerenciamento."

#: crates/clamui-core/src/cli.rs:56 crates/clamui-core/src/cli.rs:250
#: crates/clamui-core/src/cli.rs:418 crates/clamui-core/src/cli.rs:427
#: crates/clamui-core/src/cli.rs:459 crates/clamui-core/src/cli.rs:499
#: crates/clamui-core/src/cli.rs:1166 crates/clamui-core/src/cli.rs:1192
#: crates/clamui-core/src/cli.rs:1723 crates/clamui-core/src/cli.rs:1728
msgid "error"
msgstr "Erro"

#: crates/clamui-core/src/cli.rs:57
msgid "Unknown command: {command}"
msgstr "Comando desconhecido: {command}"

#. Translators: The em dash separates the application name from its description.
#: crates/clamui-core/src/cli.rs:140
msgid "ClamUI — ClamAV antivirus management\n"
msgstr "ClamUI — gerenciamento de antivírus ClamAV\n"

#: crates/clamui-core/src/cli.rs:146
msgid "Usage:"
msgstr "Uso:"

#. Translators: Keep `clamui` unchanged; it is the command name.
#: crates/clamui-core/src/cli.rs:149
msgid "  clamui                   Launch the graphical interface"
msgstr "  clamui                   Iniciar a interface gráfica"

#. Translators: Keep `clamui`, `<command>`, and `[args]` unchanged; they are command syntax.
#: crates/clamui-core/src/cli.rs:157
msgid "  clamui <command> [args]   Run a CLI command\n"
msgstr "  clamui <command> [args] Execute um comando CLI\n"

#: crates/clamui-core/src/cli.rs:163
msgid "Commands:"
msgstr "Comandos:"

#: crates/clamui-core/src/cli.rs:167
msgid ""
"\n"
"Global options:"
msgstr ""
"\n"
"Opções globais:"

#. Translators: Keep `--json` and `JSON` unchanged; they are a CLI flag and data format.
#: crates/clamui-core/src/cli.rs:170
msgid "  --json                   Machine-readable JSON output"
msgstr "  --json                   Saída JSON legível por máquina"

#. Translators: Keep `-v` and `--verbose` unchanged; they are CLI flags.
#: crates/clamui-core/src/cli.rs:178
msgid "  -v, --verbose            Verbose output"
msgstr "  -v, --verbose Saída detalhada"

