#: src/cli/install_helper.py:265
msgid ""
"ClamUI is running inside a Flatpak sandbox, which cannot install files on "
"the host. Install the matching clamui-privileged-helper package on the host "
"system instead."
msgstr ""
"ClamUI está sendo executado dentro de uma sandbox Flatpak, que não pode "
"instalar arquivos no host. Em vez disso, instale o pacote clamui-privileged-"
"helper correspondente no sistema host."

