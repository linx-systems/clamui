msgid ""
"This command installs files under /usr and /usr/share and must be run as "
"root. Try: sudo clamui install-privileged-helper"
msgstr ""
"Este comando instala arquivos em /usr e /usr/share e deve ser executado como "
"root. Experimente: sudo clamui install-privileged-helper"

