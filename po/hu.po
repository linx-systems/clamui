#, python-brace-format
msgid "Failed to install privileged helper: {error}"
msgstr "Nem sikerült telepíteni a jogosultsággal rendelkező segédprogramot: {error}"

#: src/cli/install_helper.py:249
#, python-brace-format
msgid ""
"Installed privileged helper at {bin} and polkit policy at {policy}. Saving system ClamAV "
"configuration from ClamUI should now work."
msgstr ""
"A jogosultsággal rendelkező segédprogram telepítve ide: {bin}, a polkit-házirend pedig ide: "
"{policy}. A rendszer ClamAV-beállításainak mentése a ClamUI-ból mostantól működnie kell."

#: src/cli/install_helper.py:265
msgid ""
"ClamUI is running inside a Flatpak sandbox, which cannot install files on the host. Install "
"the matching clamui-privileged-helper package on the host system instead."
msgstr ""
"A ClamUI Flatpak-homokozóban fut, amely nem telepíthet fájlokat a gazdagépre. Ehelyett "
"telepítse a megfelelő clamui-privileged-helper csomagot a gazdagép rendszerére."

#: src/cli/install_helper.py:277
msgid ""
"This command installs files under /usr and /usr/share and must be run as root. Try: sudo "
"clamui install-privileged-helper"
msgstr ""
"Ez a parancs fájlokat telepít a /usr és a /usr/share alá, ezért rendszergazdaként kell "
"futtatni. Próbálja: sudo clamui install-privileged-helper"

#: src/cli/install_helper.py:289 src/core/result_formatters.py:167 src/ui/update_view.py:682
#, python-brace-format
msgid "Error: {message}"
msgstr "Hiba: {message}"

#: src/cli/install_helper.py:297
msgid "Install the privileged config helper and polkit policy (run with sudo)"
msgstr ""
"A jogosultsággal rendelkező beállítás-segédprogram és a polkit-házirend telepítése (sudo-val "
"futtatva)"

#: src/cli/install_helper.py:299
msgid ""
"Install /usr/bin/clamui-apply-preferences and its polkit policy so ClamUI can save system "
"ClamAV configuration. Run as root (sudo). Needed for AppImage and pip installs; the Debian "
"package installs these automatically. Under Flatpak, the matching clamui-privileged-helper "
"package must be installed on the host instead."
msgstr ""
"A /usr/bin/clamui-apply-preferences és a hozzá tartozó polkit-házirend telepítése, hogy a "
"ClamUI menteni tudja a rendszer ClamAV-beállításait. Rendszergazdaként (sudo) futtatandó. "
"AppImage- és pip-telepítés esetén szükséges; a Debian-csomag ezeket automatikusan telepíti. "
"Flatpak esetén a megfelelő clamui-privileged-helper csomagot kell telepíteni a gazdagépre."

