#!/bin/bash
# Git pre-commit hook for the Rust core and TypeScript desktop application.
#
# Install with ./scripts/hooks/install-hooks.sh.

set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
cd "$REPO_ROOT"

mapfile -t STAGED_FILES < <(git diff --cached --name-only --diff-filter=ACMR)

has_rust_source=false
has_frontend_source=false
for file in "${STAGED_FILES[@]}"; do
    case "$file" in
        *.rs)
            has_rust_source=true
            ;;
        desktop/*.ts|desktop/*.tsx|desktop/**/*.ts|desktop/**/*.tsx|desktop/package.json|desktop/bun.lock|desktop/tsconfig*.json)
            has_frontend_source=true
            ;;
    esac
done

if "$has_rust_source"; then
    echo "Checking Rust formatting..."
    cargo fmt --check --all
fi

if "$has_frontend_source"; then
    echo "Type-checking TypeScript frontend..."
    (
        cd desktop
        bun run check
    )
fi
