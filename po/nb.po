#: src/core/clamav_config.py:1094
#, python-brace-format
msgid ""
"ClamUI privileged helper not installed on the host. The Flatpak sandbox "
"cannot access protected system ClamAV configuration files directly. Download "
"the matching '{package_name}' from the ClamUI releases page. On Debian/"
"Ubuntu, install it on the host with 'sudo apt install ./{package_name}'. "
"Other distributions do not currently have a supported ClamUI privileged-"
"helper package. Do not install it with 'sudo flatpak run': Flatpak cannot "
"install this helper on the host."
msgstr ""
"Den privilegerte hjelperen for ClamUI er ikke installert på vertssystemet. "
"Flatpak-sandkassen har ikke direkte tilgang til beskyttede ClamAV-"
"konfigurasjonsfiler på systemet. Last ned den tilsvarende «{package_name}» "
"fra utgivelsessiden til ClamUI. På Debian/Ubuntu installerer du den på "
"vertssystemet med «sudo apt install ./{package_name}». Andre distribusjoner "
"har foreløpig ingen støttet pakke for den privilegerte hjelperen. Ikke "
"installer den med «sudo flatpak run»: Flatpak kan ikke installere denne "
"hjelperen på vertssystemet."

#. Translators: keep the quoted command unchanged; you may use your language's quotation
#. marks.
#: src/core/clamav_config.py:1106
msgid ""
"ClamUI privileged helper not installed. Run 'sudo clamui install-privileged-"
"helper' on this host to install it and enable protected system ClamAV "
"configuration access."
msgstr ""
"Den privilegerte hjelperen for ClamUI er ikke installert. Kjør «sudo clamui "
"install-privileged-helper» på denne maskinen for å installere den og få "
"tilgang til beskyttet ClamAV-konfigurasjon."

#: src/core/clamav_config.py:1117
